package com.site.back.models;

import java.util.List;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
//import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonManagedReference;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.JoinTable;
import jakarta.persistence.ManyToMany;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
@Entity
public class Animal {

	@Id
	@GeneratedValue(strategy=GenerationType.IDENTITY)
	private Long animal_id;
	private String name;
	private String pictureName;
	
	//@JsonIgnore
	//@JsonManagedReference
	@JsonIgnoreProperties("animal")
	@ManyToMany
	@JoinTable(
	        name = "animal_behavior", // Nom de la table de jointure
	        joinColumns = @JoinColumn(name = "animal_id"), // Colonne pour l'animal
	        inverseJoinColumns = @JoinColumn(name = "behavior_id") // Colonne pour le comportement
	    )
	private List<Behavior> behaviors;
	
	public Animal(String name, String pictureName, List<Behavior> behaviors) {
		this.name = name;
		this.pictureName = pictureName;
		this.behaviors = behaviors;
	}
	
}
